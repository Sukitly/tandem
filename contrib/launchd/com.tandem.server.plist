<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the Tandem server as a user LaunchAgent: no terminal, starts at login, and restarts after a crash.

  Copy to ~/Library/LaunchAgents/ after replacing the absolute paths below:
    - /absolute/path/to/node          the Node the backend should run on, at its real installation, not a
                                      version manager's per-shell shim: with fnm,
                                      ~/.local/share/fnm/node-versions/<version>/installation/bin/node; with nvm,
                                      ~/.nvm/versions/node/<version>/bin/node
    - /absolute/path/to/tandem        this repository (`pwd`)
    - /Users/you/.tandem/tandem.log   where its output goes (launchd expands no `~`)

  Keep PATH close to the one you work with: the agent and the terminals it opens inherit this, not your shell's.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tandem.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/node</string>
    <string>/absolute/path/to/tandem/apps/server/src/main.ts</string>
    <string>--no-open</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/absolute/path/to/tandem</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart after a crash, but stay stopped after a clean one, which is what `launchctl kill SIGTERM` gives. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/you/.tandem/tandem.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/.tandem/tandem.log</string>
</dict>
</plist>
