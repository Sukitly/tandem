# Runs the Tandem server as a systemd user service: no terminal, and restarts after a crash.
#
# Copy to ~/.config/systemd/user/ after replacing the absolute paths below:
#   - /absolute/path/to/tandem   this repository (`pwd`)
#   - /usr/bin/node              the Node the backend should run on, at its real installation, not a version
#                                manager's per-shell shim (fnm: ~/.local/share/fnm/node-versions/<version>/installation/bin/node;
#                                nvm: ~/.nvm/versions/node/<version>/bin/node)
#
# Keep PATH close to the one you work with: the agent and the terminals it opens inherit this, not your shell's.
# Output goes to the journal: journalctl --user -u tandem -f

[Unit]
Description=Tandem, a local-first coding agent
Documentation=https://github.com/Sukitly/tandem
After=network.target

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/tandem
ExecStart=/usr/bin/node /absolute/path/to/tandem/apps/server/src/main.ts --no-open
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
