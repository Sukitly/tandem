{
  "name": "tandem",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run build && node apps/server/src/main.ts",
    "dev": "node apps/server/src/dev.ts",
    "service": "node apps/server/src/service.ts",
    "tunnel": "node apps/server/src/tunnel.ts",
    "update": "bash scripts/self-update.sh",
    "dev:server": "bun run --filter @tandem/server dev",
    "dev:web": "bun run --filter @tandem/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && bun run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "katex": "0.19.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
