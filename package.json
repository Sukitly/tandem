{
  "name": "tandem",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun run --filter @tandem/server dev",
    "dev:web": "bun run --filter @tandem/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && bun run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
